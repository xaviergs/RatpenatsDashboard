SUPABASE_KEY = "sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
GEMINI_API_KEY = "la-teva-clau-de-google-ai-studio"
GEMINI_MODEL = "gemini-2.5-pro"
